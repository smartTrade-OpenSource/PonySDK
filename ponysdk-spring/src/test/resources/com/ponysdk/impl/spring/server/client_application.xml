<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean name="entryPoint" class="com.ponysdk.impl.spring.server.SpringApplicationManagerTest$RecordingEntryPoint" />

    <bean name="always" class="com.ponysdk.impl.spring.server.SpringApplicationManagerTest$RecordingActivity">
        <constructor-arg value="always" />
    </bean>

    <beans profile="blue">
        <bean name="blue" class="com.ponysdk.impl.spring.server.SpringApplicationManagerTest$RecordingActivity">
            <constructor-arg value="blue" />
        </bean>
    </beans>

</beans>
